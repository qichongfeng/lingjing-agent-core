{
  "name": "@lingjing-agent/provider-anthropic",
  "version": "0.1.0-beta.5",
  "description": "Anthropic Messages adapter for @lingjing-agent/core.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@lingjing-agent/core": "workspace:*"
  },
  "dependencies": {
    "@lingjing-agent/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
