{
  "name": "@lingjing-agent/mcp",
  "version": "0.1.0-beta.7",
  "description": "MCP client bridge for @lingjing-agent/core — bridge an external MCP server's tools into core Tools. Hand-rolled JSON-RPC (legacy initialize era, tools only), zero deps. Cross-runtime entry (HTTP over core HttpTransport); stdio transport via \"@lingjing-agent/mcp/node\" (Node only).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qichongfeng/lingjing-agent-core.git",
    "directory": "packages/mcp"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@lingjing-agent/core": ">=0.1.0-beta.1"
  },
  "dependencies": {
    "@lingjing-agent/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
